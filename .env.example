# txt2book 服务端配置示例。
# 复制为 .env 后填写：cp .env.example .env（PowerShell：Copy-Item .env.example .env）
# 注意：.env 含密钥，不要提交到版本库。
#
# `npm run dev:server` 与 `npm start` 会自动加载项目根目录的 .env（存在时）；
# `docker compose` 通过 env_file 读取同一份文件。
# 仅手动执行 node server-dist/index.js 时不会加载，需改用 node --env-file=.env server-dist/index.js，
# 或先导出环境变量。
# 启动时会额外校验 SESSION_SECRET 至少 32 字符。AUTH_PASSWORD_HASH 或 SESSION_SECRET 未填写时
# 服务会 fail-closed 拒绝启动，配合 restart: unless-stopped 表现为容器反复重启；先看 docker compose logs 排查。

# 登录用户名。
AUTH_USERNAME=admin

# 登录密码的 scrypt 哈希（必填）。
# 本地生成（在项目根目录执行，密码可通过标准输入或命令行参数传入）：
#   printf '%s' '你的密码' | npm run hash-password
#   PowerShell：npm run hash-password -- '你的密码'
#   PowerShell 下不要用管道：Windows PowerShell 5.1 会把中文转成控制台代码页（静默变成 ??）。
#   PowerShell 7 或先设置 [Console]::OutputEncoding=UTF8 时管道也可用，但参数形式更稳。
# 本地命令依赖 devDependency tsx，需先 npm install；生产镜像内没有 tsx，
# 请在镜像内使用编译后的脚本（-T 关闭 TTY，未构建时先 docker compose build）：
#   printf '%s' '你的密码' | docker compose run --rm -T txt2book node server-dist/scripts/hash-password.js
#   PowerShell：docker compose run --rm -T txt2book node server-dist/scripts/hash-password.js '你的密码'
# 哈希中含 $ 字符，写入本文件时必须用单引号包裹，
# 否则 docker compose 会把 $ 当作变量展开导致哈希损坏：
#   AUTH_PASSWORD_HASH='scrypt$16384$8$1$...'
AUTH_PASSWORD_HASH=''

# 会话 Cookie 的签名密钥（必填，至少 32 个字符）。
# 生成：
#   openssl rand -base64 32
#   PowerShell：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# 是否只通过 HTTPS 发送会话 Cookie。
# 直接用 http 访问时保持 false；放在 HTTPS 反向代理后必须设为 true。
COOKIE_SECURE=false

# 是否信任反向代理传入的 X-Forwarded-For / X-Forwarded-Proto。
# 只有反向代理会覆盖（而不是追加）这两个头时才设为 true，
# 否则客户端可以伪造 IP 绕过登录限流。
TRUST_PROXY=false

# 以下为可选配置，留空时使用默认值。
# 注意：compose 的端口映射 8080:3000 与 healthcheck 固定使用 3000；
# 修改 PORT 需同步修改 docker-compose.yml。
# PORT=3000
# SESSION_TTL_DAYS=30
# MAX_COVER_BYTES=10485760
# COVER_TIMEOUT_MS=8000
# RATE_LIMIT_PER_MIN=30
